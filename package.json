{
  "name": "scapemaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Educational soundscape workstation for filmmaking students — static, backend-free.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "leaflet": "^1.9.4"
  }
}
